{
  "schemaVersion": 1,
  "id": "chatcontrol",
  "version": "${version}",
  "name": "ChatControl",
  "description": "Minecraft controlled by Twitch/YouTube chat - Core mod",
  "authors": [
    "ChatControl Team"
  ],
  "contact": {
    "homepage": "https://github.com/chatcontrol",
    "sources": "https://github.com/chatcontrol/chatcontrol-mod"
  },
  "license": "MIT",
  "icon": "assets/chatcontrol/icon.png",
  "environment": "server",
  "entrypoints": {
    "server": [
      "com.chatcontrol.ChatControlMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
