---
interface Props {
  eventNumber: number;
  action: string;
  displayName: string;
  enabled: boolean;
  cooldown: number;
  params: Record<string, number | string>;
}

const { eventNumber, action, displayName, enabled, cooldown, params } = Astro.props;
---

<div class={`event-card ${!enabled ? 'disabled' : ''}`} data-event-number={eventNumber}>
  <div class="event-header">
    <span class="event-number">{eventNumber}</span>
    <span class="event-name">{displayName || action}</span>
    <button class={`event-toggle ${enabled ? 'active' : 'inactive'}`} data-field="enabled">
      {enabled ? 'Activo' : 'Inactivo'}
    </button>
  </div>
  <div class="event-details">
    <div class="event-detail">
      <span class="detail-label">Cooldown</span>
      <span class="detail-value">{cooldown}s</span>
    </div>
    {Object.entries(params).map(([key, value]) => (
      <div class="event-detail">
        <span class="detail-label">{key}</span>
        <span class="detail-value">{value}</span>
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll('.event-toggle').forEach(btn => {
    btn.addEventListener('click', async () => {
      const card = (btn as HTMLElement).closest('.event-card')!;
      const eventNumber = parseInt(card.dataset.eventNumber!);
      const current = btn.classList.contains('active');
      const API_URL = (import.meta as any).env?.PUBLIC_API_URL || '';

      try {
        const csrfRes = await fetch(`${API_URL}/api/csrf-token`, { credentials: 'include' });
        const { csrf_token } = await csrfRes.json();

        const res = await fetch(`${API_URL}/api/events/${eventNumber}`, {
          method: 'PUT',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf_token },
          body: JSON.stringify({ enabled: !current }),
        });

        if (res.ok) {
          btn.classList.toggle('active');
          btn.classList.toggle('inactive');
          btn.textContent = current ? 'Inactivo' : 'Activo';
          card.classList.toggle('disabled');
        }
      } catch (e) {
        console.error('Failed to toggle event:', e);
      }
    });
  });
</script>

<style>
  .event-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    transition: all 0.2s;
  }

  .event-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--purple);
    transform: translateY(-2px);
  }

  .event-card.disabled {
    opacity: 0.5;
  }

  .event-card.disabled:hover {
    border-color: var(--border);
    transform: none;
  }

  .event-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .event-number {
    background: var(--purple);
    color: white;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .disabled .event-number {
    background: var(--text-muted);
  }

  .event-name {
    font-weight: 600;
    font-size: 1.1rem;
    flex: 1;
  }

  .event-toggle {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .event-toggle.active {
    background: rgba(0, 200, 83, 0.15);
    color: var(--green);
  }

  .event-toggle.inactive {
    background: rgba(255, 68, 68, 0.15);
    color: var(--red);
  }

  .event-toggle:hover {
    transform: scale(1.05);
  }

  .event-details {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 0.75rem;
  }

  .event-detail {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .detail-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .detail-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    color: var(--text-primary);
  }
</style>
