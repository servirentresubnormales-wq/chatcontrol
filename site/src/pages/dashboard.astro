---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EventCard from '../components/EventCard.astro';
import { mockStreamer, mockEvents } from '../data/mock';
---

<Layout title="Dashboard">
  <Header />
  <main class="dashboard">
    <div class="dashboard-header">
      <h1>ChatControl</h1>
    </div>

    <div class="status-grid">
      <div class="status-card">
        <div class="status-row">
          <span class="status-label">Streamer</span>
          <span class="status-value">{mockStreamer.displayName}</span>
        </div>
      </div>
      <div class="status-card">
        <div class="status-row">
          <span class="status-label">Twitch</span>
          <span class={`status-indicator ${mockStreamer.twitchConnected ? 'connected' : 'disconnected'}`}>
            <span class="dot"></span>
            {mockStreamer.twitchConnected ? 'Conectado' : 'Desconectado'}
          </span>
        </div>
        <div class="status-detail">@{mockStreamer.twitchUsername}</div>
      </div>
      <div class="status-card">
        <div class="status-row">
          <span class="status-label">Minecraft</span>
          <span class={`status-indicator ${mockStreamer.minecraftConnected ? 'connected' : 'disconnected'}`}>
            <span class="dot"></span>
            {mockStreamer.minecraftConnected ? 'Conectado' : 'Desconectado'}
          </span>
        </div>
        <div class="status-detail">{mockStreamer.minecraftUsername}</div>
      </div>
    </div>

    <section class="events-section">
      <div class="section-header">
        <h2>Eventos</h2>
        <span class="event-count">{mockEvents.filter(e => e.enabled).length} activos</span>
      </div>
      <div class="events-grid">
        {mockEvents.map(event => (
          <EventCard event={event} editable={true} />
        ))}
      </div>
    </section>

    <div class="api-notice">
      <p>Datos mock — El backend real se implementará en una fase posterior.</p>
      <p>API futura: <code>GET /api/events</code> · <code>PUT /api/events/:id</code></p>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .dashboard {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .dashboard-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .status-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .status-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .status-label {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .status-value {
    font-weight: 600;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .connected .dot {
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
  }

  .disconnected .dot {
    background: var(--red);
    box-shadow: 0 0 8px var(--red);
  }

  .connected {
    color: var(--green);
  }

  .disconnected {
    color: var(--red);
  }

  .status-detail {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
  }

  .events-section {
    margin-bottom: 2rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .section-header h2 {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .event-count {
    font-size: 0.8rem;
    color: var(--green);
    background: rgba(0, 200, 83, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .api-notice {
    background: var(--bg-card);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .api-notice p + p {
    margin-top: 0.5rem;
  }

  .api-notice code {
    background: var(--bg-surface);
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: var(--purple-light);
  }
</style>
