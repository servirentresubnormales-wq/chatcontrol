---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { API_URL, IS_CONFIGURED } from '../lib/config';
---

<Layout title="Verificar Email - ChatControl">
  <Header />
  <main class="verify-page">
    <div class="verify-card">
      <div class="verify-icon">✉️</div>
      <h1>Verifica tu correo</h1>
      <p class="verify-desc">Te hemos enviado un correo de confirmación.</p>
      <p class="verify-desc">Revisa tu correo para continuar.</p>
      
      <div id="error-banner" class="error-banner" style="display:none;">
        <p id="error-message"></p>
      </div>
      
      <div id="success-banner" class="success-banner" style="display:none;">
        <p>Email verificado correctamente. Redirigiendo...</p>
      </div>
      
      <div id="countdown-section" style="margin: 1.5rem 0;">
        <p class="countdown-text" id="countdown-text">Token expira en: 15:00</p>
      </div>
      
      <button id="resend-btn" class="btn-twitch" style="margin-top: 1rem;">
        Reenviar correo
      </button>
      
      <div class="verify-note">
        <p>¿No recibiste el correo? Revisa tu carpeta de spam o haz clic en reenviar.</p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .verify-page {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 200px);
    padding: 2rem 1.5rem;
  }
  .verify-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 3rem;
    max-width: 480px;
    width: 100%;
    text-align: center;
  }
  .verify-icon { font-size: 3rem; margin-bottom: 1rem; }
  .verify-card h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 0.5rem; }
  .verify-desc { color: var(--text-secondary); margin-bottom: 0.5rem; }
  .error-banner {
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    background: rgba(255, 68, 68, 0.15);
    border: 1px solid rgba(255, 68, 68, 0.3);
    border-radius: var(--radius-sm);
    color: var(--red);
    font-size: 0.85rem;
  }
  .success-banner {
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    background: rgba(0, 200, 83, 0.15);
    border: 1px solid rgba(0, 200, 83, 0.3);
    border-radius: var(--radius-sm);
    color: var(--green);
    font-size: 0.85rem;
  }
  .btn-twitch {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--purple);
    color: #fff;
    padding: 1rem 2rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    width: 100%;
    justify-content: center;
    transition: all 0.2s;
    border: none;
    cursor: pointer;
  }
  .btn-twitch:hover { background: var(--purple-dark); transform: translateY(-2px); }
  .btn-twitch:disabled { background: var(--bg-surface); color: var(--text-muted); cursor: not-allowed; transform: none; }
  .countdown-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .countdown-text.warning { color: var(--red); }
  .verify-note {
    margin-top: 1.5rem;
    padding: 1rem;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>

<script>
  const BASE = import.meta.env.BASE_URL;
  const API = import.meta.env.PUBLIC_API_URL || '';
  
  let csrfToken: string | null = null;
  let countdownInterval: number | null = null;
  
  async function getCsrf(): Promise<string> {
    if (csrfToken) return csrfToken;
    const res = await fetch(`${API}/api/csrf-token`, { credentials: 'include' });
    if (!res.ok) throw new Error('NOT_AUTHENTICATED');
    const data = await res.json();
    csrfToken = data.csrf_token;
    return csrfToken!;
  }
  
  async function checkStatus() {
    try {
      const res = await fetch(`${API}/api/email/status`, { credentials: 'include' });
      if (res.status === 401) { window.location.href = BASE + 'login/'; return; }
      const data = await res.json();
      if (data.verified) {
        document.getElementById('success-banner')!.style.display = 'block';
        document.getElementById('countdown-section')!.style.display = 'none';
        document.getElementById('resend-btn')!.style.display = 'none';
        setTimeout(() => { window.location.href = BASE + 'dashboard/connect/'; }, 2000);
      }
    } catch (e) {
      console.error('Status check failed:', e);
    }
  }
  
  async function sendVerification() {
    const btn = document.getElementById('resend-btn') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const token = await getCsrf();
      const res = await fetch(`${API}/api/email/send`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'X-CSRF-Token': token, 'Content-Type': 'application/json' },
      });
      if (res.status === 429) {
        showError('Demasiadas solicitudes. Espera unos minutos.');
        return;
      }
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        showError(err.error || 'Error al enviar correo');
        return;
      }
      const data = await res.json();
      startCountdown(data.expires_at);
    } catch (e: any) {
      if (e.message === 'NOT_AUTHENTICATED') { window.location.href = BASE + 'login/'; return; }
      showError('Error de conexión');
    } finally {
      btn.disabled = false;
    }
  }
  
  function startCountdown(expiresAt: string) {
    if (countdownInterval) clearInterval(countdownInterval);
    const target = new Date(expiresAt).getTime();
    countdownInterval = window.setInterval(() => {
      const diff = target - Date.now();
      if (diff <= 0) {
        clearInterval(countdownInterval!);
        document.getElementById('countdown-text')!.textContent = 'Token expirado. Haz clic en reenviar.';
        document.getElementById('countdown-text')!.classList.add('warning');
        return;
      }
      const mins = Math.floor(diff / 60000);
      const secs = Math.floor((diff % 60000) / 1000);
      const el = document.getElementById('countdown-text')!;
      el.textContent = `Token expira en: ${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
      if (diff < 60000) el.classList.add('warning');
    }, 1000);
  }
  
  function showError(msg: string) {
    const el = document.getElementById('error-banner')!;
    document.getElementById('error-message')!.textContent = msg;
    el.style.display = 'block';
  }
  
  document.getElementById('resend-btn')!.addEventListener('click', sendVerification);
  
  checkStatus();
  sendVerification();
</script>
