# Twitch OAuth Configuration
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
TWITCH_REDIRECT_URI=https://YOUR_BACKEND_URL/auth/twitch/callback

# Flask Secret Key (generate a random one)
SECRET_KEY=your_random_secret_key_here

# Application Settings
BASE_URL=http://localhost:5000
PORT=5000
DB_PATH=chatcontrol.db
FLASK_ENV=development

# Frontend Configuration
FRONTEND_URL=https://servirentresubnormales-wq.github.io/chatcontrol
ALLOWED_ORIGINS=https://servirentresubnormales-wq.github.io

# Heartbeat timeout (seconds) - if no heartbeat received in this time, bridge is marked disconnected
HEARTBEAT_TIMEOUT=60

# Heartbeat check secret (required in production)
HEARTBEAT_CHECK_SECRET=your_heartbeat_check_secret_here

# Link code TTL in seconds (default: 60)
LINK_CODE_TTL=60

# Email verification TTL in seconds (default: 900 = 15 minutes)
EMAIL_VERIFICATION_TTL=900

# Email Configuration (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=ChatControl <noreply@chatcontrol.app>
